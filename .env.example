# --- LLM (required) ---------------------------------------------------------------
# Comma-separated pool; ids are assigned in order: key_1, key_2, key_3, ...
# Get free Gemini keys at https://aistudio.google.com/apikey (use two different projects).
LLM_API_KEYS=your-first-key,your-second-key
# Any LiteLLM model string; the provider must match the keys above.
LLM_MODEL=gemini/gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30

# --- Behaviour --------------------------------------------------------------------
CACHE_ENABLED=true
# Enables the X-Simulate-Failure header. Keep false in public deployments.
ENABLE_FAILURE_SIMULATION=true
# Optional default system prompt when a session has none.
DEFAULT_SYSTEM_PROMPT=

# --- Storage ----------------------------------------------------------------------
DATABASE_URL=sqlite:////data/app.db

# --- Web --------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Backend URL the browser uses (frontend build-time variable).
VITE_API_URL=http://localhost:8000
